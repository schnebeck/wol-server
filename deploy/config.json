{
  "listen": "::",
  "port": 80,
  "data_dir": "/var/lib/wol-server",
  "allowed_networks": ["auto"],
  "wol_interface": "",
  "wifi_interface": "wlan0",
  "hotspot_enabled": true,
  "hotspot_ssid": "",
  "hotspot_delay_minutes": 5,
  "hotspot_retry_minutes": 5,
  "wifi_socket": "/run/wol-wifi/control.sock",
  "status_led": true,
  "session_days": 30,
  "status_cache_seconds": 5,
  "log_level": "INFO"
}
