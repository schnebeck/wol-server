#
# WOL-Server: sets up the Pi automatically on the first boot.
# The settings are in wol-setup.txt, not here.
#
# Important: when writing with Raspberry Pi Imager do NOT use "OS customisation" -
# otherwise the Imager would replace this file with its own.

# firstboot.sh sets the hostname; cloud-init must not change it again.
preserve_hostname: true

# Troubleshooting with a card reader: state every 15 s in wol-trace.log on the boot partition
# (bootcmd runs early on every boot while cloud-init is active; firstboot.sh stops it)
bootcmd:
  - [systemd-run, --unit=wol-boottrace, --no-block, /bin/bash, /boot/firmware/wol-server/deploy/boottrace.sh]

# Also write cloud-init output to the boot partition
output:
  all: "| tee -a /var/log/cloud-init-output.log /boot/firmware/wol-cloud-init.log"

runcmd:
  - [bash, /boot/firmware/wol-server/deploy/firstboot.sh]
