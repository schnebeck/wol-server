[Unit]
Description=WOL-Server: DHCP and DNS (dnsmasq)
Documentation=file:///opt/wol-server/README.md
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
# English messages: wol-wifi parses the journal (rejected devices, query log)
Environment=LC_ALL=C
# The configuration is generated exclusively by WOL-Server (web GUI -> Network)
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/wol-dns/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/wol-dns/dnsmasq.conf
# SIGHUP: reload reservations and custom DNS entries without interruption
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
UMask=0022

# dnsmasq starts as root (ports 53/67) and then switches to the user dnsmasq by itself
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/wol-dns
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryMax=40M

[Install]
WantedBy=multi-user.target
