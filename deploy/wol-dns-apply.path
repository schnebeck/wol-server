[Unit]
Description=WOL-Server: detect network jobs from the web GUI
Documentation=file:///opt/wol-server/docs/proposal-dhcp-dns.md

[Path]
# wol-wifi places validated jobs there (Apply, release lease, DHCP scan, …)
DirectoryNotEmpty=/var/lib/wol-wifi/dns/requests
Unit=wol-dns-apply.service

[Install]
WantedBy=paths.target
