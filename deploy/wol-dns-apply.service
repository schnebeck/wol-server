[Unit]
Description=WOL-Server: run network job from the web GUI
Documentation=file:///opt/wol-server/README.md

[Service]
Type=oneshot
# root: writes /etc/wol-dns, controls wol-dns.service, scans for DHCP servers (port 68).
# wol-wifi generated the files from validated fields; here they are only tested and installed.
WorkingDirectory=/opt/wol-server
Environment=PYTHONUNBUFFERED=1 LC_ALL=C
ExecStart=/usr/bin/python3 -m wolserver.dnsjob
TimeoutStartSec=3min
Nice=5
