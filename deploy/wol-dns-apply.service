[Unit]
Description=WOL-Server: Netzwerk-Auftrag aus der Web-GUI ausführen
Documentation=file:///opt/wol-server/docs/vorschlag-dhcp-dns.md

[Service]
Type=oneshot
# root: schreibt /etc/wol-dns, steuert wol-dns.service, sucht nach DHCP-Servern (Port 68).
# Die Dateien hat wol-wifi aus geprüften Feldern erzeugt; hier wird nur getestet und eingespielt.
WorkingDirectory=/opt/wol-server
Environment=PYTHONUNBUFFERED=1 LC_ALL=C
ExecStart=/usr/bin/python3 -m wolserver.dnsjob
TimeoutStartSec=3min
Nice=5
