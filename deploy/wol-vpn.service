[Unit]
Description=WOL-Server: run VPN job from the web GUI
Documentation=file:///opt/wol-server/README.md
After=network-online.target

[Service]
Type=oneshot
# root: installs openvpn, writes /etc/openvpn and controls openvpn-client@wol.
# wol-wifi has validated the configuration beforehand (no scripts, plugins or file references).
ExecStart=/bin/bash /opt/wol-server/deploy/vpn-apply.sh
# apt takes time on the Zero
TimeoutStartSec=20min
Nice=5
