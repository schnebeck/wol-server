[Unit]
Description=WOL-Server: VPN-Auftrag aus der Web-GUI ausführen
Documentation=file:///opt/wol-server/README.md
After=network-online.target

[Service]
Type=oneshot
# root: installiert openvpn, schreibt /etc/openvpn und steuert openvpn-client@wol.
# Die Konfiguration hat wol-wifi vorher geprüft (keine Skripte, Plugins oder Dateiverweise).
ExecStart=/bin/bash /opt/wol-server/deploy/vpn-apply.sh
# apt auf dem Zero braucht Zeit
TimeoutStartSec=20min
Nice=5
